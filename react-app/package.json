    "postbuild:seo": "node ../scripts/generate-sitemap.mjs && node ../scripts/prerender-meta.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {

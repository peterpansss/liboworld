# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
coverage
*.local

# Env / secrets (never commit). `.env.example` is the only env file we track.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright test artefacts
test-results/
playwright-report/

# Personal screenshots & screen recordings
public/IMG_*.PNG
public/IMG_*.JPG
public/mockups/IMG_*.PNG
public/mockups/IMG_*.JPG
public/ScreenRecording_*
public/mockups/ScreenRecording_*
*.mov
*.MP4
# On macOS (core.ignorecase) *.MP4 also ignores .mp4. Site videos that must ship:
!public/downloads/blueprint/teasers/*.mp4

# Ad-hoc image versions (with spaces or -2 suffix)
**/* -2.jpg
**/*  -2.jpg
public/images/categories/ *
# Leading slash anchors this to react-app/Images/. Unanchored "Images/" also
# matched public/images/ (git matches case-insensitively on macOS), silently
# ignoring every NEW file added there.
/Images/
Fitbod Generate Workout Example /
ReferenceImagesReal/
scripts/_logs/
supabase/.temp/

# Personal screenshots & screen recordings
public/IMG_*.PNG
public/IMG_*.JPG
public/mockups/IMG_*.PNG
public/mockups/IMG_*.JPG
public/ScreenRecording_*
public/mockups/ScreenRecording_*
*.mov
*.MP4
# On macOS (core.ignorecase) *.MP4 also ignores .mp4. Site videos that must ship:
!public/downloads/blueprint/teasers/*.mp4

# Ad-hoc image versions (with spaces or -2 suffix)
**/* -2.jpg
**/*  -2.jpg
public/images/categories/ *
# Leading slash anchors this to react-app/Images/. Unanchored "Images/" also
# matched public/images/ (git matches case-insensitively on macOS), silently
# ignoring every NEW file added there.
/Images/
Fitbod Generate Workout Example /
ReferenceImagesReal/
scripts/_logs/
supabase/.temp/

# Keep last: the site's transparent hero loops are HEVC-alpha .mov for Safari
# (18 Nov 2026), so they must beat the *.mov rules above.
!public/loops/*.mov

# Copy this file to `.env.local` for local development. Production /
# staging builds receive these via GitHub Actions secrets (see
# `.github/workflows/deploy.yml`). Files matching `.env*.local` are
# gitignored — never commit real keys.
#
# Most of the runtime config lives in Supabase Edge Function secrets, NOT
# in this file — including the Resend API key used by the affiliate-apply
# function (set via `supabase secrets set RESEND_API_KEY=…`).
# This file is only for client-side keys (Stripe publishable, etc.) plus
# the Supabase project the client connects to.

# Supabase project (required — module load throws if missing)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe (optional — the Stripe modal falls back to an offline placeholder
# when the publishable key is absent, so dev/staging without Stripe still
# build and render). Tier-to-price mapping lives in the `create_payment_intent`
# Supabase Edge Function, NOT in frontend env (set there via
# `supabase secrets set STRIPE_PRICE_ENTRY=price_… STRIPE_PRICE_SILVER=…`).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

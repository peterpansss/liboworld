# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` is the committed template.
#
# Most of the runtime config lives in Supabase Edge Function secrets, NOT
# in this file — including the Resend API key used by the affiliate-apply
# function (set via `supabase secrets set RESEND_API_KEY=…`).
# This file is only for client-side keys (Stripe publishable, etc.).

# Stripe — payment intents on /giveaway and /pricing.
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_STRIPE_PRICE_ENTRY=
# VITE_STRIPE_PRICE_SILVER=
# VITE_STRIPE_PRICE_GOLD=
# VITE_STRIPE_PRICE_PREMIUM=

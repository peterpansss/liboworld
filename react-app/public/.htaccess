<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # NOTE: none of these names may collide with a React route. The media
  # folder is "founder-media", not "founder", because a real dist/founder/
  # directory makes Apache DirectorySlash-redirect /founder -> /founder/,
  # which then matched this rule and 403'd the /founder page.
  #
  # Asset directories return real 404 if the file is missing instead of
  # falling back to index.html. Prevents Cloudflare from caching the SPA
  # shell as the response for image/asset URLs that don't exist yet at the
  # moment of the first request, which then poisons the cache for hours
  # after the asset is actually deployed.
  RewriteRule ^(images|assets|videos|fonts|audio|founder-media|funnel-media)/ - [L,R=404]

  # Shared-routine deep links (/w/:id) → the branded share-OG stub at
  # dist/w/index.html, so crawlers/unfurlers see a Libo "Shared workout" card
  # instead of the generic homepage. The stub is still the SPA shell, so React
  # boots and renders the real routine for human visitors. (/w/ alone is a real
  # dir, already served by the -d check above.)
  RewriteRule ^w/.+ /w/index.html [L]

  # Legacy legal pages. dist/terms.html and dist/privacy.html were real files
  # copied out of public/, so the -f check at the top matched them and Apache
  # served them in preference to the React /terms and /privacy routes. They
  # still carried stale pre-flag legal text (a "Points Packs & Giveaway
  # Tickets" section, an EU Art. 16(m) withdrawal waiver for converting bought
  # points into draw tickets), so they were deleted on 2026-08-27. These 301s
  # keep old inbound links and crawler-indexed URLs landing on the live pages
  # instead of being swallowed by the catch-all below and dumped on the
  # homepage. Must stay above that catch-all.
  RewriteRule ^terms\.html$ /terms [R=301,L]
  RewriteRule ^privacy\.html$ /privacy [R=301,L]

  # Everything else → index.html (React Router handles routing client-side)
  RewriteRule ^ index.html [L]
</IfModule>

# Block direct access to backup files
<Files "*.bak">
    Order Allow,Deny
    Deny from all
</Files>
